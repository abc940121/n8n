        "1.2.4": {
          "name": "Stop and Error",
          "mapped_nodes": ["n8n-nodes-base.stopAndError"],
          "description": "強制停止工作流並報錯"
        }
      },
      "1.3 Sub-Workflow Management": {
        "1.3.1": {
          "name": "Execute Workflow",
          "mapped_nodes": ["n8n-nodes-base.executeWorkflow"],
          "description": "呼叫並執行另一個工作流"
        },
        "1.3.2": {
          "name": "Workflow Trigger",
          "mapped_nodes": ["n8n-nodes-base.executeWorkflowTrigger"],
          "description": "作為子工作流的接收起點"
        }
      }
