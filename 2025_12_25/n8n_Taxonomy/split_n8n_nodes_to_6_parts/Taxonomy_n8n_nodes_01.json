{
  "Taxonomy": {
    "1. Workflow Logic & Control": {
      "1.1 Conditional Routing": {
        "1.1.1": {
          "name": "If (Boolean Logic)",
          "mapped_nodes": ["n8n-nodes-base.if"],
          "description": "判斷 True/False 條件並分流資料"
        },
        "1.1.2": {
          "name": "Switch (Multi-path)",
          "mapped_nodes": ["n8n-nodes-base.switch"],
          "description": "根據數值匹配多個輸出路徑"
        },
        "1.1.3": {
          "name": "Merge (Join Streams)",
          "mapped_nodes": ["n8n-nodes-base.merge"],
          "description": "合併多個分支的資料流"
        }
      },
      "1.2 Loop & Execution Control": {
        "1.2.1": {
          "name": "Split In Batches (Loop)",
          "mapped_nodes": ["n8n-nodes-base.splitInBatches"],
          "description": "將資料分批處理以建立迴圈"
        },
        "1.2.2": {
          "name": "Wait (Time/Webhook)",
          "mapped_nodes": ["n8n-nodes-base.wait"],
          "description": "暫停工作流直到時間到達或訊號觸發"
        },
        "1.2.3": {
          "name": "NoOp (Pass-through)",
          "mapped_nodes": ["n8n-nodes-base.noOp"],
          "description": "無操作節點，用於註解或對齊"
