    {
      "id": "convert-markdown",
      "name": "Convert to Markdown",
      "parameters": {
        "html": "={{ $json.bodyPreview || $json.body }}",
        "options": {
          "keepLists": true,
          "removeLinks": true,
          "removeStyles": true
        }
      },
      "position": [
        1080,
        200
      ],
      "type": "n8n-nodes-base.markdown",
      "typeVersion": 1
    },
    {
      "id": "clean-content",
      "name": "Clean Email Content",
      "parameters": {
        "jsCode": "// Remove common email signatures and headers\nlet content = $input.first().json.data;\n\n// Remove empty lines\ncontent = content.replace(/\\n{3,}/g, '\\n\\n');\n\n// Remove common email patterns\ncontent = content.replace(/[<>]/g, '');\n\n// Trim whitespace\ncontent = content.trim();\n\nreturn {\n  json: {\n    content: content,\n    subject: $json.subject,\n    from: $json.from.emailAddress.address,\n    date: $json.receivedDateTime\n  }\n};"
      },
      "position": [
        1300,
        200
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "id": "prepare-ai",
      "name": "Prepare for AI",
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "prompt",
              "name": "prompt",
              "type": "string",
              "value": "=You are an email categorization assistant. Analyze the following email and categorize it into one of these categories:\n\nCategories:\n- \"action\" - Requires immediate action or response\n- \"junk\" - Spam, promotional, or irrelevant content\n- \"business\" - Work-related communications\n- \"saas\" - Software service notifications\n- \"receipt\" - Purchase confirmations or invoices\n- \"newsletter\" - Regular updates or newsletters\n- \"personal\" - Personal communications\n\nEmail Details:\nSubject: {{ $json.subject }}\nFrom: {{ $json.from }}\nDate: {{ $json.date }}\nContent: {{ $json.content }}\n\nReturn ONLY the category name in lowercase without any explanation."
            }
          ]
        },
        "options": {}
      },
      "position": [
        1520,
        200
      ],
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4
    },
    {
      "id": "ai-agent",
      "name": "AI Agent",
      "parameters": {
        "options": {
          "systemMessage": "=You are an intelligent email categorization system. Your task is to analyze emails and assign them to the most appropriate category.\n\nAvailable Categories:\n1. \"action\" - Emails requiring immediate attention or response\n2. \"junk\" - Spam, promotional content, or irrelevant messages\n3. \"business\" - Professional work-related communications\n4. \"saas\" - Software-as-a-Service notifications and updates\n5. \"receipt\" - Purchase confirmations, invoices, or payment receipts\n6. \"newsletter\" - Periodic updates, magazines, or subscription content\n7. \"personal\" - Non-work related personal communications\n\nAnalysis Guidelines:\n- Consider the sender, subject line, and content\n- Look for keywords indicating urgency or action items\n- Identify promotional language or spam indicators\n- Recognize transactional emails (receipts, confirmations)\n- Distinguish between automated and human-written messages\n\nReturn ONLY the category name in lowercase without any additional text or explanation."
        }
      },
      "position": [
        1740,
        200
      ],
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.9
    },
    {
      "id": "categorize-email",
      "name": "Categorize Email",
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "category",
              "name": "category",
              "type": "string",
              "value": "={{ $json.output.toLowerCase() }}"
            },
            {
              "id": "confidence",
              "name": "confidence",
              "type": "number",
              "value": "100"
            }
          ]
        },
        "options": {}
      },
      "position": [
        1960,
        200
      ],
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4
    },
    {
      "id": "update-category",
      "name": "Update Email Category",
      "parameters": {
        "additionalFields": {
          "categories": [
            "={{ $json.category }}"
          ]
        },
        "emailId": "={{ $('Get New Emails').item.json.id }}",
        "operation": "update"
      },
      "position": [
        2180,
        200
      ],
      "type": "n8n-nodes-base.microsoftOutlook",
      "typeVersion": 2
    },
    {
      "id": "route-category",
      "name": "Route by Category",
      "parameters": {
        "options": {},
        "rules": {
          "values": [
            {
              "conditions": {
                "combinator": "and",
                "conditions": [
                  {
                    "leftValue": "={{ $json.category }}",
                    "operator": {
                      "operation": "equals",
                      "type": "string"
                    },
                    "rightValue": "junk"
                  }
                ],
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                }
              },
              "outputKey": "junk",
              "renameOutput": true
            },
            {
              "conditions": {
                "combinator": "and",
                "conditions": [
                  {
                    "leftValue": "={{ $json.category }}",
                    "operator": {
                      "operation": "equals",
                      "type": "string"
                    },
                    "rightValue": "receipt"
                  }
                ],
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                }
              },
              "outputKey": "receipt",
              "renameOutput": true
            },
            {
              "conditions": {
                "combinator": "and",
                "conditions": [
                  {
                    "leftValue": "={{ $json.category }}",
                    "operator": {
                      "operation": "notEquals",
                      "type": "string"
                    },
                    "rightValue": "junk"
                  },
                  {
                    "leftValue": "={{ $json.category }}",
                    "operator": {
                      "operation": "notEquals",
                      "type": "string"
                    },
                    "rightValue": "receipt"
                  }
                ],
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                }
              },
              "outputKey": "other",
              "renameOutput": true
            }
          ]
        }
      },
      "position": [
        2400,
        200
      ],
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2
