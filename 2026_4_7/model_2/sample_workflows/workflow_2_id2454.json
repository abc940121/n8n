      ],
      "type": "n8n-nodes-base.microsoftOutlook",
      "typeVersion": 2
    },
    {
      "id": "filter-processed",
      "name": "Filter Processed Emails",
      "parameters": {
        "conditions": {
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.categories }}",
