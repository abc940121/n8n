    {
      "id": "create-structure",
      "name": "Create post title and structure",
      "parameters": {
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "=You are a professional content writer. Create a blog post structure based on the following keywords: {{ $json.Keywords }}.\n\nRequirements:\n- Create a catchy title\n- Write an engaging introduction (150-200 words)\n- Create {{ $json.chapter_count }} chapter titles with brief descriptions\n- Write a compelling conclusion (100-150 words)\n- Article length: {{ $json.article_length }}\n\nFormat the output as JSON with fields: title, introduction, chapters (array), conclusion"
            }
          ]
        },
        "promptType": "define",
        "text": "={{ $json.Keywords }}"
      },
      "position": [
        340,
        0
      ],
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.7
    },
    {
      "id": "check-data",
      "name": "Check data",
      "parameters": {
        "conditions": {
          "combinator": "and",
          "conditions": [
            {
              "id": "title-check",
              "leftValue": "={{ $json.output.title }}",
              "operator": {
                "operation": "notEmpty",
                "singleValue": true,
                "type": "string"
              },
              "rightValue": ""
            },
            {
              "id": "intro-check",
              "leftValue": "={{ $json.output.introduction }}",
              "operator": {
                "operation": "notEmpty",
                "singleValue": true,
                "type": "string"
              },
              "rightValue": ""
            },
            {
              "id": "chapters-check",
              "leftValue": "={{ $json.output.chapters.length }}",
              "operator": {
                "operation": "greaterEqual",
                "type": "number"
              },
              "rightValue": "={{ $('Settings').item.json.chapter_count }}"
            },
            {
              "id": "conclusion-check",
              "leftValue": "={{ $json.output.conclusion }}",
              "operator": {
                "operation": "notEmpty",
                "singleValue": true,
                "type": "string"
              },
              "rightValue": ""
            }
          ],
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          }
        },
        "options": {}
      },
      "position": [
        580,
        0
      ],
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2
    },
    {
