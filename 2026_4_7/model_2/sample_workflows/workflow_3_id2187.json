    {
      "id": "create-chapters",
      "name": "Create chapters text",
      "parameters": {
        "batching": {},
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "=You are a professional content writer. Write a detailed chapter for a blog post.\n\nChapter title: {{ $json.title }}\nChapter description: {{ $json.description }}\nOriginal keywords: {{ $('On form submission').item.json.Keywords }}\nArticle length: {{ $('Settings').item.json.article_length }}\n\nWrite a comprehensive, well-researched chapter that:\n- Expands on the chapter title and description\n- Incorporates relevant information about the original keywords\n- Is informative, engaging, and valuable to readers\n- Uses proper formatting with paragraphs\n- Maintains a professional yet accessible tone\n\nWord count: If article_length is \"Short\" use 300-400 words, \"Medium\" use 500-700 words, \"Long\" use 800-1000 words"
            }
          ]
        },
        "promptType": "define",
        "text": "={{ $json.title }} - {{ $json.description }}"
      },
      "position": [
        1060,
        -100
      ],
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.7
    },
    {
      "id": "prepare-content",
      "name": "Prepare content",
      "parameters": {
        "jsCode": "// Get original data from form\nconst originalData = $('On form submission').first().json;\nconst settings = $('Settings').first().json;\n\n// Get structured output\nconst structuredOutput = $('Create post title and structure').first().json.output;\n\n// Get all chapter texts\nconst chapterItems = $('Create chapters text').all();\nlet chapterTexts = [];\n\nfor (let i = 0; i < chapterItems.length; i++) {\n  const chapterOutput = chapterItems[i].json.output;\n  chapterTexts.push(chapterOutput.content);\n}\n\n// Prepare HTML content\nlet htmlContent = '';\n\n// Title\nhtmlContent += `<h1>${structuredOutput.title}</h1>`;\n\n// Introduction\nhtmlContent += `<p>${structuredOutput.introduction.replace(/\\n/g, '<br>')}</p>`;\n\n// Chapters\nfor (let i = 0; i < chapterTexts.length; i++) {\n  htmlContent += `<h2>${structuredOutput.chapters[i].title}</h2>`;\n  htmlContent += `<p>${chapterTexts[i].replace(/\\n/g, '<br>')}</p>`;\n}\n\n// Conclusion\nhtmlContent += `<h2>Conclusion</h2>`;\nhtmlContent += `<p>${structuredOutput.conclusion.replace(/\\n/g, '<br>')}</p>`;\n\n// Prepare data for WordPress\nconst wordpressData = {\n  title: structuredOutput.title,\n  content: htmlContent,\n  status: 'draft',\n  excerpt: structuredOutput.introduction.substring(0, 150) + '...',\n  categories: [1], // Default category ID\n  tags: originalData.Keywords.split(',').map(k => k.trim())\n};\n\nreturn wordpressData;"
      },
      "position": [
        1300,
        -100
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
